# AI Investor — all secrets and account settings in one place.
# Copy this file to `.env` (same folder) and fill in real values. `.env` is git-ignored.
# Restart the backend after changing `.env`.
#
# An account is available only when all its values below are filled in;
# leave an account's values empty to switch it off.

# ---------------------------------------------------------------------------
# Which broker account to trade with: ibkr-paper | ibkr-live | etoro-demo | etoro-real
# If you change this, it wins at the next backend start (over the last choice made in the UI).
ACTIVE_ACCOUNT=ibkr-paper

# Allow making a LIVE (real money) account active. Keep false unless you really mean it.
ALLOW_LIVE_TRADING=false

# ---------------------------------------------------------------------------
# Interactive Brokers
# Your IBKR username/password are entered in TWS / IB Gateway itself, not here.
# The app connects to the running TWS / IB Gateway on this host/port.

# Paper account (TWS 7497, IB Gateway 4002)
IBKR_PAPER_HOST=127.0.0.1
IBKR_PAPER_PORT=7497
IBKR_PAPER_CLIENT_ID=1
IBKR_PAPER_ACCOUNT_ID=DU0000000

# Live account (TWS 7496, IB Gateway 4001)
IBKR_LIVE_HOST=
IBKR_LIVE_PORT=
IBKR_LIVE_CLIENT_ID=
IBKR_LIVE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# eToro (API key + user key from the eToro API portal)

# Demo / virtual portfolio
ETORO_DEMO_API_KEY=your-demo-api-key
ETORO_DEMO_USER_KEY=your-demo-user-key

# Real money
ETORO_REAL_API_KEY=
ETORO_REAL_USER_KEY=

# ---------------------------------------------------------------------------
# AI providers (empty key = provider switched off). Priority order is set in the app settings.
OPENAI_MAIN_API_KEY=
GEMINI_FREE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Database
DB_URL=jdbc:postgresql://localhost:5432/ai_investor
DB_USERNAME=ai_investor
DB_PASSWORD=change-me
